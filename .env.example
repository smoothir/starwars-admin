# Copie ce fichier en .env puis remplis les vraies valeurs de TON serveur
# Discord Game of Thrones — jamais celles d'un autre bot/serveur.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
MONGO_URI=

# Port d'écoute. La plupart des hébergeurs (Railway, Render) injectent
# automatiquement leur propre PORT — cette valeur ne sert qu'en local.
PORT=3000

# Identifiants pour se connecter au site (Basic Auth) — choisis un mot de passe fort
ADMIN_USER=admin
ADMIN_PASSWORD=
