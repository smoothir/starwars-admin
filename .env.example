# Copie ce fichier en ".env" et remplis les valeurs. NE METS JAMAIS de vraie
# valeur ici : ce fichier est versionné sur GitHub.

# --- Discord (même application que le bot) ---
CLIENT_ID=
CLIENT_SECRET=
GUILD_ID=

# --- Base de données (même MONGO_URI que le bot) ---
MONGO_URI=

# --- Connexion Discord OAuth2 ---
# Doit aussi être déclarée dans le portail développeur Discord (OAuth2 > Redirects).
DISCORD_REDIRECT_URI=https://ton-site.example.com/auth/discord/callback

# Longue valeur aléatoire, par ex. :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Optionnel ---
PORT=3000
# Dossier des images d'objets (celui du bot) si le site est hébergé à côté du bot.
ITEM_IMAGE_DIR=
